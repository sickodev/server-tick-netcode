# Copy this file to .env and fill in values for local overrides.
# .env is gitignored — never commit it.

# WebSocket URL the frontend connects to.
# Default (below) works when running docker-compose locally.
# For production, set this to your Koyeb gateway URL:
#   VITE_GATEWAY_URL=wss://your-gateway.koyeb.app/ws
VITE_GATEWAY_URL=ws://localhost:8080/ws
